# Production Multi-Stage Dockerfile for Frontend

# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci || npm install

COPY . .
RUN npm run build

# Stage 2: Production Nginx Server
FROM nginx:1.26-alpine
WORKDIR /usr/share/nginx/html

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf* /etc/nginx/conf.d/

RUN if [ ! -f /etc/nginx/conf.d/nginx.conf ] && [ ! -f /etc/nginx/conf.d/default.conf ]; then \
      echo 'server { listen 80; root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf; \
    elif [ -f /etc/nginx/conf.d/nginx.conf ]; then \
      mv /etc/nginx/conf.d/nginx.conf /etc/nginx/conf.d/default.conf; \
    fi

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
