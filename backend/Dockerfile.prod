# Production Multi-Stage Dockerfile for FastAPI Backend

# Stage 1: Build & Dependency Installation
FROM python:3.11-slim AS builder
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir poetry==1.8.5

COPY pyproject.toml poetry.lock* ./
RUN poetry config virtualenvs.create false && (poetry export -f requirements.txt --output requirements.txt --without-hashes || true)

COPY . /app
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir --prefix=/install -r requirements.txt; else pip install --no-cache-dir --prefix=/install .; fi

# Stage 2: Distroless Production Execution
FROM gcr.io/distroless/python3-debian12:nonroot
WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /app /app

ENV PYTHONPATH=/usr/local/lib/python3.11/site-packages:/app
USER 65532:65532

EXPOSE 8000
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
